---
import { langOf, textsOf } from '@/i18n';
import type { Synth } from '@/synths';

interface Props {
  synth: Synth;
}

const { downloads, paid } = Astro.props.synth.data;
const t = textsOf(langOf(Astro.url)).get;
---

{
  paid?.buyUrl && (
    <p>
      <a class="button" href={paid.buyUrl}>
        {t.buy} {paid.price}
      </a>
    </p>
  )
}
{
  downloads.length > 0 && (
    <>
      {paid && <p class="muted">{t.demo}</p>}
      <ul class="tags">
        {downloads.map(({ label, url }) => (
          <li>
            <a href={url}>{label}</a>
          </li>
        ))}
      </ul>
    </>
  )
}
{!paid?.buyUrl && downloads.length === 0 && <p class="muted">{t.unavailable}</p>}
