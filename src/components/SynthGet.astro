---
import type { CollectionEntry } from 'astro:content';

interface Props {
  synth: CollectionEntry<'synths'>;
}

const { downloads, paid } = Astro.props.synth.data;
---

{
  paid?.buyUrl && (
    <p>
      <a class="button" href={paid.buyUrl}>
        Buy for {paid.price}
      </a>
    </p>
  )
}
{
  downloads.length > 0 && (
    <>
      {paid && <p class="muted">Demo:</p>}
      <ul class="tags">
        {downloads.map(({ label, url }) => (
          <li>
            <a href={url}>{label}</a>
          </li>
        ))}
      </ul>
    </>
  )
}
{!paid?.buyUrl && downloads.length === 0 && <p class="muted">Not available yet.</p>}
