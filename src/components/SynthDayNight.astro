---
/**
 * A synth's window by night and by day: its pictures in a pair of its skins (nightAndDayOf() in src/synths.ts), the
 * light one over the dark one from the left to a line, day and night on a planet, each one's name and its line under
 * it. Without the script, the first pair only, the line in the middle; with it, the line can be dragged (or moved with the keys, as a range), a button shows
 * the next pair (the line staying where it is), and the first time the window is in view, the day rises over it from
 * its left, unless the visitor asked for less motion.
 */
import { Image } from 'astro:assets';
import { langOf, textsOf } from '@/i18n';
import type { NightAndDay } from '@/synths';

interface Props {
  pairs: NightAndDay[];
}

const { pairs } = Astro.props;
const lang = langOf(Astro.url);
const t = textsOf(lang).synths.dayNight;
const widths = [800, 1200, 1600, 2400];
const sizes = '(min-width: 64rem) 51rem, 100vw';
// While a pair is shown, the button names the next
const next = (index: number) => pairs[(index + 1) % pairs.length];
---

<figure class="day-night" data-day-night>
  {
    pairs.length > 1 && (
      <button type="button" class="switch" hidden data-switch>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 8h15l-4-4M20 16H5l4 4" />
        </svg>
        <span data-switch-label>{t.show(next(0).day.name, next(0).night.name)}</span>
      </button>
    )
  }
  <div class="view" data-view>
    {
      pairs.map(({ night, day }, index) => (
        <div
          class="pair"
          hidden={index > 0}
          data-pair
          data-day={day.name}
          data-day-caption={day.caption[lang]}
          data-night={night.name}
          data-night-caption={night.caption[lang]}
          data-next={t.show(next(index).day.name, next(index).night.name)}
        >
          <Image class="night" src={night.image} alt={night.alt[lang]} widths={widths} sizes={sizes} />
          <Image class="day" src={day.image} alt={day.alt[lang]} widths={widths} sizes={sizes} />
        </div>
      ))
    }
    <div class="line" aria-hidden="true"><span class="handle"></span></div>
    <input type="range" min="0" max="100" value="50" aria-label={t.line} hidden data-input />
  </div>
  <figcaption>
    <span class="side">
      <span class="skin">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
        </svg>
        <span data-day-name>{pairs[0].day.name}</span>
      </span>
      <span class="caption" data-day-line>{pairs[0].day.caption[lang]}</span>
    </span>
    <span class="side night">
      <span class="skin">
        <span data-night-name>{pairs[0].night.name}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
      </span>
      <span class="caption" data-night-line>{pairs[0].night.caption[lang]}</span>
    </span>
    <span class="hint" hidden data-hint>{t.hint}</span>
  </figcaption>
</figure>

<script>
  const lessMotion = matchMedia('(prefers-reduced-motion: reduce)');

  for (const figure of document.querySelectorAll<HTMLElement>('[data-day-night]')) {
    const view = figure.querySelector<HTMLElement>('[data-view]')!;
    const input = figure.querySelector<HTMLInputElement>('[data-input]')!;
    const hint = figure.querySelector<HTMLElement>('[data-hint]')!;
    const pairs = [...figure.querySelectorAll<HTMLElement>('[data-pair]')];
    const button = figure.querySelector<HTMLButtonElement>('[data-switch]');

    /** Puts the line at `day`: how much of the window, from its left, is by day, in %. */
    const set = (day: number) => {
      day = Math.min(100, Math.max(0, day));
      figure.style.setProperty('--day', `${day}%`);
      input.value = String(Math.round(day));
    };
    const follow = (event: PointerEvent) => {
      const box = view.getBoundingClientRect();
      set(((event.clientX - box.left) / box.width) * 100);
    };

    // A mouse puts the line where it presses, and drags it; a finger only drags it sideways, up and down scrolling the page
    view.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      figure.classList.remove('rising');
      view.setPointerCapture(event.pointerId);
      if (event.pointerType === 'mouse') follow(event);
    });
    view.addEventListener('pointermove', (event) => {
      if (!view.hasPointerCapture(event.pointerId)) return;
      figure.classList.add('dragging');
      follow(event);
    });
    const release = () => figure.classList.remove('dragging');
    view.addEventListener('pointerup', release);
    view.addEventListener('pointercancel', release);
    input.addEventListener('input', () => {
      figure.classList.remove('rising');
      set(Number(input.value));
    });

    // The day rises over the window the first time most of it is in view
    if (!lessMotion.matches) {
      set(0);
      new IntersectionObserver(
        ([entry], observer) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          figure.classList.add('rising');
          set(50);
          const risen = (event: TransitionEvent) => {
            if (event.propertyName !== '--day') return;
            figure.classList.remove('rising');
            figure.removeEventListener('transitionend', risen);
          };
          figure.addEventListener('transitionend', risen);
        },
        { threshold: 0.6 },
      ).observe(view);
    }

    // The pairs: the one shown, the others unseen over it (loaded, so that they show at once), the names under it its
    let shown = 0;
    const show = (index: number) => {
      shown = index;
      pairs.forEach((pair, i) => {
        pair.hidden = false;
        pair.classList.toggle('away', i !== index);
        pair.inert = i !== index;
      });
      figure.querySelector('[data-day-name]')!.textContent = pairs[index].dataset.day!;
      figure.querySelector('[data-day-line]')!.textContent = pairs[index].dataset.dayCaption!;
      figure.querySelector('[data-night-name]')!.textContent = pairs[index].dataset.night!;
      figure.querySelector('[data-night-line]')!.textContent = pairs[index].dataset.nightCaption!;
      if (button) button.querySelector('[data-switch-label]')!.textContent = pairs[index].dataset.next!;
    };
    show(0);
    button?.addEventListener('click', () => show((shown + 1) % pairs.length));
    if (button) button.hidden = false;

    input.hidden = hint.hidden = false;
    // The line moves smoothly from now on, not from the middle to where the day rises from: that worked out first
    getComputedStyle(figure).getPropertyValue('--day');
    figure.classList.add('enhanced');
  }
</script>

<style>
  /* How much of the window, from its left, is by day: a registered property, so that it moves smoothly */
  @property --day {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 50%;
  }

  .day-night {
    margin: 2rem 0 2.5rem;
  }

  /* The button to the next pair, over the window */
  .switch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 auto 1rem;
    padding: 0.45rem 1rem;
    background: color-mix(in srgb, var(--recess) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--surface) 45%, transparent);
    border-radius: 999px;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .switch[hidden] {
    display: none;
  }

  .switch:hover {
    border-color: var(--highlight);
    color: var(--highlight);
  }

  .switch svg {
    stroke: currentColor;
  }

  /* The pairs, the first giving the window its size, the others over it; the ones not shown fade out */
  .pair {
    position: relative;
    transition: opacity 0.45s;
  }

  .pair + .pair {
    position: absolute;
    inset: 0;
  }

  .pair.away {
    opacity: 0;
  }

  .view {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--surface) 25%, transparent);
    border-radius: var(--radius);
    box-shadow:
      0 2rem 4rem -2rem rgb(0 0 0 / 0.8),
      0 0 5rem -1rem color-mix(in srgb, var(--accent) 30%, transparent);
    user-select: none;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-drag: none;
  }

  /* The day: the light skin, from the left to the line, through a narrow dawn */
  .day {
    position: absolute;
    inset: 0;
    height: 100%;
    mask-image: linear-gradient(to right, #000 calc(var(--day) - 0.4%), transparent calc(var(--day) + 0.4%));
  }

  /* The line, lit like the dawn; its handle, half day and half night, only with the script that moves it */
  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--day);
    width: 2px;
    translate: -50%;
    background: var(--highlight);
    box-shadow: 0 0 0.75rem 0.1rem color-mix(in srgb, var(--highlight) 70%, transparent);
    pointer-events: none;
  }

  .handle {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.5rem;
    height: 2.5rem;
    translate: -50% -50%;
    border: 2px solid var(--highlight);
    border-radius: 50%;
    background: linear-gradient(90deg, var(--foreground) 50%, var(--recess) 50%);
    box-shadow: 0 0 1rem color-mix(in srgb, var(--highlight) 60%, transparent);
  }

  .enhanced .view {
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .enhanced .handle {
    display: block;
  }

  .view:has(input:focus-visible) .handle {
    outline: 2px solid var(--foreground);
    outline-offset: 3px;
  }

  /* The range the keys move the line with, unseen */
  input {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .enhanced {
    transition: --day 0.25s ease-out;
  }

  .enhanced.dragging {
    transition: none;
  }

  .enhanced.rising {
    transition: --day 2.4s cubic-bezier(0.3, 0, 0.2, 1);
  }

  /* The day's skin on the left, the night's on the right, each its name over its line; the hint under them */
  figcaption {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
    color: var(--surface);
    font-size: 0.9rem;
  }

  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .night {
    align-items: flex-end;
    text-align: right;
  }

  .skin {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--foreground);
    font-family: var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  .hint {
    grid-column: 1 / -1;
    margin-top: 0.25rem;
    text-align: center;
  }

  .hint[hidden] {
    display: none;
  }

  svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--highlight);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
