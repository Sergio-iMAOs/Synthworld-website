---
/**
 * A thing in space, drawn for one of the engine's features on the home page: two stars that move each other, matter
 * flowing between them (anything modulates anything); a constellation, one of its lines being rewired (a patch you can
 * rewire); a comet gliding (no clicks); a planet ringed with scales of 7, 12, 19, 24 and 31 notes, their steps going
 * round (any tuning); a satellite orbiting a planet, signalling (in your DAW or on its own). Or for a part of a synth on
 * its page: a star with three planets round it, one with a moon, in a dust of pulses (its sound: three oscillators, a
 * sub-oscillator, a noise); a black hole, its disk of light in eight arcs going round it (its eight effect slots); a die
 * tumbling, its pips craters (its randomiser); meteors falling one after another (what plays its notes in turn); a star
 * and its copies spread to its sides, twinkling out of step (unison); a planet that turns from day to night, the line
 * between them lit (its skins). Lit from the top left, as SynthWorld's planet, in the palette's colours. While the
 * mouse is over it, or over what it's in, it moves, unless the visitor asked for less motion.
 */
export type SpaceObjectKind =
  | 'binary'
  | 'constellation'
  | 'comet'
  | 'rings'
  | 'satellite'
  | 'system'
  | 'blackhole'
  | 'die'
  | 'meteors'
  | 'cluster'
  | 'phases';

/** Every kind, for a page that names one in a text (<!-- object: <kind> -->) to check it's one. */
export const spaceObjectKinds: SpaceObjectKind[] = ['binary', 'constellation', 'comet', 'rings', 'satellite', 'system', 'blackhole', 'die', 'meteors', 'cluster', 'phases'];

interface Props {
  kind: SpaceObjectKind;
}

const { kind } = Astro.props;
// Its gradients' and clips' ids, unique in the page: every SVG of a page shares them
const id = (name: string) => `space-object-${kind}-${name}`;
const url = (name: string) => `url(#${id(name)})`;

/** A star's glint, round 0, 0 */
const GLINT = 'M0-7C.7-.7.7-.7 7 0C.7.7.7.7 0 7C-.7.7-.7.7-7 0C-.7-.7-.7-.7 0-7Z';

// The tuning's rings, each a scale of so many notes: a ring of so many steps, turning in so many seconds
const rings = [
  { radius: 31, notes: 7 },
  { radius: 36, notes: 12 },
  { radius: 41, notes: 19 },
  { radius: 46, notes: 24 },
  { radius: 51, notes: 31 },
].map(({ radius, notes }, index) => {
  const length = 2 * Math.PI * radius;
  return { radius, notes, dash: `${(length / notes - 2).toFixed(2)} 2`, turn: 12 + index * 3.5 };
});
/** Seen tilted: a ring's plane, round the planet's centre */
const RING_PLANE = 'translate(60 60) rotate(-16) scale(1 0.3)';

// The constellation: its stars (x, y, size, lit), the lines between them, and the one being rewired
const stars: [number, number, number, boolean][] = [
  [16, 42, 0.8, false],
  [40, 22, 1.1, false],
  [72, 30, 0.9, false],
  [102, 16, 0.7, false],
  [56, 60, 1.3, true],
  [24, 86, 0.8, false],
  [90, 74, 1, true],
  [62, 102, 0.7, false],
];
const lines = [
  [0, 1],
  [1, 2],
  [2, 3],
  [1, 4],
  [4, 5],
  [4, 6],
  [6, 7],
];
const rewired = [2, 6];

// The satellite's orbit, seen tilted round the planet's centre (a circle squashed to so much of its height), where on
// it the satellite rests (degrees from its right end: on its far side, clear of the planet), and its signal's arcs over
// its antenna. Over the planet, the satellite is drawn whole while it's on the orbit's near half, which it enters as it
// turns past the orbit's right end: so much of a turn after its start
const ORBIT_TILT = 0.28;
const ORBIT_PLANE = `translate(50 66) rotate(-14) scale(1 ${ORBIT_TILT})`;
const ORBIT_START = -35;
const NEAR_FROM = -ORBIT_START / 360;
const signals = [5, 9, 13].map((radius) => {
  const side = radius * 0.7;
  return `M${-side} ${-8.5 - side}A${radius} ${radius} 0 0 1 ${side} ${-8.5 - side}`;
});

// The star's system, seen tilted as the satellite's orbit is (its inner orbit clear of the star): each planet's orbit,
// size, colour, where on its orbit it rests (degrees from its right end), how long a turn takes it (seconds), and the
// one with a moon; round them, a dust of pulses up and down, as a velvet noise's display draws them
const SYSTEM_TILT = 0.42;
const SYSTEM_PLANE = `translate(60 60) rotate(-12) scale(1 ${SYSTEM_TILT})`;
const planets = [
  { radius: 26, size: 3.2, colour: 'accent', start: 205, turn: 9, moon: false },
  { radius: 38, size: 4.4, colour: 'highlight', start: 330, turn: 15, moon: true },
  { radius: 50, size: 3.6, colour: 'foreground', start: 115, turn: 24, moon: false },
];
const dust: [number, number, boolean][] = [
  [12, 30, true],
  [22, 18, false],
  [98, 20, true],
  [108, 34, false],
  [16, 92, false],
  [30, 104, true],
  [92, 100, false],
  [106, 88, true],
  [6, 62, true],
  [114, 58, false],
  [70, 8, false],
  [48, 112, true],
];

// The black hole's disk, seen nearly edge on: its far half behind the hole, its near half over it; its eight arcs
// (the circle less a gap between each)
const DISK_PLANE = 'translate(60 61) rotate(-8) scale(1 0.26)';
const DISK = 36;
const slots = `${((2 * Math.PI * DISK) / 8 - 3.5).toFixed(2)} 3.5`;

// The die, a cube seen from above its corner: each face a square drawn onto it (matrix: its sides' two ways and its
// corner), the light falling from the top left; its pips, on the unit square (1 on top, 2 and 3 on its sides)
const faces = [
  { class: 'top', matrix: 'matrix(30 -17 30 17 30 45)', pips: [[0.5, 0.5]] },
  { class: 'left', matrix: 'matrix(30 17 0 34 30 45)', pips: [[0.27, 0.27], [0.73, 0.73]] },
  { class: 'right', matrix: 'matrix(30 -17 0 34 60 62)', pips: [[0.25, 0.25], [0.5, 0.5], [0.75, 0.75]] },
];

// The meteors, one after another: where each one's head is, and its trail's length
const meteors = [
  [22, 58, 28],
  [44, 66, 36],
  [66, 74, 30],
  [88, 82, 24],
];

// The star and its copies (the unison's voices), spread from the middle: how far out each is
const voices = [-3, -2, -1, 0, 1, 2, 3];

// The planet that turns from day to night: its night, a shadow wider than it, going across it
const PHASE_RADIUS = 26;
---

<svg class="object" viewBox="0 0 120 120" aria-hidden="true">
  <defs>
    <radialGradient id={id('shade')} cx="0.32" cy="0.28" r="0.95">
      <stop offset="0" class="lit"></stop>
      <stop offset="0.32" class="clear"></stop>
      <stop offset="0.32" class="unlit"></stop>
      <stop offset="0.75" class="dark"></stop>
      <stop offset="1" class="night"></stop>
    </radialGradient>
    <radialGradient id={id('glow-highlight')}>
      <stop offset="0" class="highlight-glow"></stop>
      <stop offset="1" class="highlight-none"></stop>
    </radialGradient>
    <radialGradient id={id('glow-accent')}>
      <stop offset="0" class="accent-glow"></stop>
      <stop offset="1" class="accent-none"></stop>
    </radialGradient>
    <radialGradient id={id('glow-foreground')}>
      <stop offset="0" class="foreground-glow"></stop>
      <stop offset="1" class="foreground-none"></stop>
    </radialGradient>
  </defs>

  {
    kind === 'binary' && (
      <>
        <defs>
          <radialGradient id={id('star-highlight')}>
            <stop offset="0" class="core" />
            <stop offset="0.55" class="highlight-stop" />
          </radialGradient>
          <radialGradient id={id('star-accent')}>
            <stop offset="0" class="core" />
            <stop offset="0.55" class="accent-stop" />
          </radialGradient>
        </defs>
        <circle class="course" cx="60" cy="60" r="16" />
        <circle class="course" cx="60" cy="60" r="38" />
        <g class="turn">
          <circle cx="44" cy="60" r="32" fill={url('glow-highlight')} />
          <circle cx="98" cy="60" r="21" fill={url('glow-accent')} />
          <path class="flow" d="M89 55Q76 40 58 52" />
          <circle cx="44" cy="60" r="14" fill={url('star-highlight')} />
          <circle cx="98" cy="60" r="9" fill={url('star-accent')} />
        </g>
      </>
    )
  }

  {
    kind === 'constellation' && (
      <>
        {lines.map(([a, b]) => (
          <line class="link" x1={stars[a][0]} y1={stars[a][1]} x2={stars[b][0]} y2={stars[b][1]} />
        ))}
        <line class="flow rewire" x1={stars[rewired[0]][0]} y1={stars[rewired[0]][1]} x2={stars[rewired[1]][0]} y2={stars[rewired[1]][1]} />
        {stars.map(([x, y, size, lit]) => (
          <g transform={`translate(${x} ${y}) scale(${size})`}>
            <circle r="9" fill={url(lit ? 'glow-highlight' : 'glow-foreground')} />
            <path class={lit ? 'highlight' : 'foreground'} d={GLINT} />
          </g>
        ))}
      </>
    )
  }

  {
    kind === 'comet' && (
      <>
        <defs>
          <linearGradient id={id('tail')} gradientUnits="userSpaceOnUse" x1="88" y1="32" x2="16" y2="102">
            <stop offset="0" class="tail-head" />
            <stop offset="0.45" class="tail-middle" />
            <stop offset="1" class="accent-none" />
          </linearGradient>
          <linearGradient id={id('core')} gradientUnits="userSpaceOnUse" x1="88" y1="32" x2="16" y2="102">
            <stop offset="0" class="core" />
            <stop offset="0.6" class="foreground-none" />
          </linearGradient>
        </defs>
        <g class="glide">
          <path class="ion" d="M88 32 18 88" stroke={url('core')} />
          <path d="M82 26Q44 48 12 106Q54 70 94 38Z" fill={url('tail')} />
          <path d="M85 31Q54 54 32 92Q60 64 91 37Z" fill={url('core')} />
          <circle cx="88" cy="32" r="15" fill={url('glow-highlight')} />
          <circle class="foreground" cx="88" cy="32" r="4.5" />
        </g>
      </>
    )
  }

  {
    kind === 'rings' && (
      <>
        <defs>
          <clipPath id={id('front')}>
            <rect x="-60" y="0" width="120" height="60" />
          </clipPath>
          <clipPath id={id('globe')}>
            <circle cx="60" cy="60" r="22" />
          </clipPath>
        </defs>
        <circle cx="60" cy="60" r="34" fill={url('glow-accent')} />
        {/* The rings behind the planet, the planet, then the rings' near half over it */}
        <g transform={RING_PLANE}>
          {rings.map(({ radius, notes, dash, turn }, index) => (
            <circle class:list={['ring', { lit: notes === 12, backward: index % 2 === 1 }]} r={radius} stroke-dasharray={dash} style={`animation-duration: ${turn}s`} />
          ))}
        </g>
        <g clip-path={url('globe')}>
          <circle class="accent" cx="60" cy="60" r="22" />
          <g transform="rotate(-16 60 60)">
            <rect class="band-dark" x="30" y="45" width="60" height="4" />
            <rect class="band-light" x="30" y="54" width="60" height="6" />
            <rect class="band-dark" x="30" y="65" width="60" height="3" />
            <rect class="band-light" x="30" y="71" width="60" height="5" />
          </g>
          <circle cx="60" cy="60" r="22" fill={url('shade')} />
        </g>
        <g transform={RING_PLANE}>
          <g clip-path={url('front')}>
            {rings.map(({ radius, notes, dash, turn }, index) => (
              <circle class:list={['ring', { lit: notes === 12, backward: index % 2 === 1 }]} r={radius} stroke-dasharray={dash} style={`animation-duration: ${turn}s`} />
            ))}
          </g>
        </g>
      </>
    )
  }

  {
    kind === 'satellite' && (
      <>
        <defs>
          <clipPath id={id('front')}>
            <rect x="-60" y="0" width="120" height="60" />
          </clipPath>
        </defs>
        <circle cx="50" cy="66" r="38" fill={url('glow-accent')} />
        {/*
         * The orbit and the satellite twice: whole behind the planet, then over it the orbit's near half and the
         * satellite while it's on it (not cut where the orbit is, or its signal's arcs would be). The satellite goes
         * round in the orbit's plane, turned back as much as it goes round, and its plane's squash undone: it stays as
         * it's drawn, only tilted as the orbit is
         */}
        {['behind', 'over'].map((layer) => (
          <>
            {layer === 'over' && (
              <>
                <circle class="accent" cx="50" cy="66" r="26" />
                <circle cx="50" cy="66" r="26" fill={url('shade')} />
              </>
            )}
            <g transform={ORBIT_PLANE}>
              <circle class="course" r="46" clip-path={layer === 'over' ? url('front') : undefined} />
              <g
                class={layer === 'over' ? 'near' : undefined}
                style={layer === 'over' ? `--near-from: ${NEAR_FROM}` : undefined}
              >
                <g transform={`rotate(${ORBIT_START})`}>
                  <g class="orbit">
                    <g transform="translate(46 0)">
                      <g class="upright">
                        <g transform={`rotate(${-ORBIT_START}) scale(1 ${1 / ORBIT_TILT})`}>
                          <rect class="panel" x="-16" y="-2.5" width="11" height="5" />
                          <rect class="panel" x="5" y="-2.5" width="11" height="5" />
                          <path class="panel-lines" d="M-12.3-2.5v5M-8.7-2.5v5M8.7-2.5v5M12.3-2.5v5" />
                          <path class="mast" d="M0-3.5v-4" />
                          <rect class="foreground" x="-3.5" y="-3.5" width="7" height="7" rx="1" />
                          <circle class="foreground" cy="-8.5" r="1.3" />
                          {signals.map((d, index) => (
                            <path class="signal" d={d} style={`--rest: ${0.75 - index * 0.2}; animation-delay: ${index * 0.25}s`} />
                          ))}
                        </g>
                      </g>
                    </g>
                  </g>
                </g>
              </g>
            </g>
          </>
        ))}
      </>
    )
  }

  {
    kind === 'system' && (
      <>
        <defs>
          <radialGradient id={id('star')}>
            <stop offset="0" class="core" />
            <stop offset="0.55" class="highlight-stop" />
          </radialGradient>
        </defs>
        <circle cx="60" cy="60" r="30" fill={url('glow-highlight')} />
        <g transform={SYSTEM_PLANE}>
          {planets.map(({ radius }) => (
            <circle class="course" r={radius} />
          ))}
        </g>
        {dust.map(([x, y, up]) => (
          <rect class={up ? 'foreground' : 'accent'} x={x - 0.9} y={y - 0.9} width="1.8" height="1.8" />
        ))}
        <circle cx="60" cy="60" r="6.5" fill={url('star')} />
        {/* Each planet round its orbit in the orbit's plane, turned back as much and its plane's squash undone, as the satellite */}
        {planets.map(({ radius, size, colour, start, turn, moon }) => (
          <g transform={SYSTEM_PLANE}>
            <g transform={`rotate(${start})`}>
              <g class="orbit" style={`animation-duration: ${turn}s`}>
                <g transform={`translate(${radius} 0)`}>
                  <g class="upright" style={`animation-duration: ${turn}s`}>
                    <g transform={`rotate(${-start}) scale(1 ${1 / SYSTEM_TILT})`}>
                      <circle class={colour} r={size} />
                      <circle r={size} fill={url('shade')} />
                      {moon && (
                        <g transform="scale(1 0.45)">
                          <g class="orbit" style="animation-duration: 5s">
                            <circle class="foreground" cx={size + 3.6} r="1.2" />
                          </g>
                        </g>
                      )}
                    </g>
                  </g>
                </g>
              </g>
            </g>
          </g>
        ))}
      </>
    )
  }

  {
    kind === 'blackhole' && (
      <>
        <defs>
          <clipPath id={id('far')}>
            <rect x="-60" y="-60" width="120" height="60" />
          </clipPath>
          <clipPath id={id('near')}>
            <rect x="-60" y="0" width="120" height="60" />
          </clipPath>
        </defs>
        <circle cx="60" cy="60" r="46" fill={url('glow-accent')} />
        {/* The disk's far half, its light bent over the hole and under it, the hole in its ring of light, the near half */}
        {['far', 'near'].map((half) => (
          <>
            {half === 'near' && (
              <>
                <path class="lens" d="M41 60A19 20 0 0 1 79 60" />
                <path class="lens faint" d="M45 62A15 12 0 0 0 75 62" />
                <circle class="hole" cx="60" cy="60" r="13" />
                <circle class="photon" cx="60" cy="60" r="13.6" />
              </>
            )}
            <g transform={DISK_PLANE}>
              <g clip-path={url(half)}>
                <g class="swirl">
                  <circle class="disk-glow" r={DISK} />
                  <circle class="disk" r={DISK} stroke-dasharray={slots} />
                  <circle class="disk-hot" r={DISK - 9} />
                </g>
              </g>
            </g>
          </>
        ))}
      </>
    )
  }

  {
    kind === 'die' && (
      <>
        <circle cx="60" cy="62" r="40" fill={url('glow-accent')} />
        <path class="highlight" d={GLINT} transform="translate(18 26) scale(0.55)" />
        <path class="foreground" d={GLINT} transform="translate(102 98) scale(0.4)" />
        <g class="tumble">
          {faces.map(({ class: face, matrix, pips }) => (
            <g transform={matrix}>
              <rect class:list={['face', face]} width="1" height="1" />
              {/* A crater: its far wall lit, its pit towards the light */}
              {pips.map(([x, y]) => (
                <>
                  <circle class="rim" cx={x} cy={y} r={pips.length === 1 ? 0.14 : 0.1} />
                  <circle class:list={['pip', { one: pips.length === 1 }]} cx={x - 0.018} cy={y - 0.022} r={pips.length === 1 ? 0.125 : 0.088} />
                </>
              ))}
            </g>
          ))}
          <path class="edge" d="M30 45 60 28 90 45M60 62V96M30 45 60 62 90 45" />
        </g>
      </>
    )
  }

  {
    kind === 'meteors' && (
      <>
        <defs>
          <linearGradient id={id('trail')} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="26" y2="-26">
            <stop offset="0" class="tail-head" />
            <stop offset="0.45" class="tail-middle" />
            <stop offset="1" class="accent-none" />
          </linearGradient>
        </defs>
        <path class="foreground" d={GLINT} transform="translate(26 22) scale(0.5)" />
        <path class="highlight" d={GLINT} transform="translate(100 44) scale(0.4)" />
        <path class="foreground" d={GLINT} transform="translate(30 100) scale(0.35)" />
        {meteors.map(([x, y, length], index) => (
          <g transform={`translate(${x} ${y})`}>
            <g class="fall" style={`animation-delay: ${(index * 0.22).toFixed(2)}s`}>
              <path class="trail" d={`M0 0L${length} ${-length}`} stroke={url('trail')} />
              <circle r="6" fill={url('glow-highlight')} />
              <circle class="foreground" r="1.8" />
            </g>
          </g>
        ))}
      </>
    )
  }

  {
    kind === 'cluster' && (
      <>
        <path class="field" d="M6 60H114" />
        {voices.map((voice) => (
          <g transform={`translate(${60 + voice * 15} ${60 + voice * voice * 1.6 - 6})`}>
            <g class="spread" style={`--voice: ${voice}`}>
              <g class="twinkle" style={`animation-duration: ${(1.6 + Math.abs(voice) * 0.13 + (voice < 0 ? 0.05 : 0)).toFixed(2)}s`}>
                <g transform={`scale(${(1.25 - Math.abs(voice) * 0.17).toFixed(2)})`}>
                  <circle r="10" fill={url(voice === 0 ? 'glow-highlight' : 'glow-accent')} />
                  <path class={voice === 0 ? 'highlight' : 'foreground'} d={GLINT} />
                </g>
              </g>
            </g>
          </g>
        ))}
      </>
    )
  }

  {
    kind === 'phases' && (
      <>
        <defs>
          <clipPath id={id('disc')}>
            <circle cx="60" cy="60" r={PHASE_RADIUS} />
          </clipPath>
        </defs>
        <circle cx="60" cy="60" r="40" fill={url('glow-accent')} />
        <g clip-path={url('disc')}>
          <circle class="day" cx="60" cy="60" r={PHASE_RADIUS} />
          <g transform="rotate(-16 60 60)">
            <rect class="band-dark" x="30" y="47" width="60" height="4" />
            <rect class="band-light" x="30" y="56" width="60" height="5" />
            <rect class="band-dark" x="30" y="66" width="60" height="3" />
          </g>
          <g class="phase">
            <circle class="night" cx={60 + PHASE_RADIUS * 1.15} cy="60" r={PHASE_RADIUS * 1.3} />
          </g>
          <circle cx="60" cy="60" r={PHASE_RADIUS} fill={url('shade')} />
        </g>
      </>
    )
  }
</svg>

<style>
  .object {
    display: block;
    width: clamp(8.5rem, 22vw, 10.5rem);
    height: auto;
    overflow: visible;
  }

  .foreground {
    fill: var(--foreground);
  }

  .highlight {
    fill: var(--highlight);
  }

  .accent {
    fill: var(--accent);
  }

  /*
   * The gradients' stops: light and shade on a sphere (the light fading out and the shade in each in its own colour, as
   * a gradient between the two would go through grey), glows, stars' white-hot cores
   */
  .lit {
    stop-color: var(--foreground);
    stop-opacity: 0.45;
  }

  .clear {
    stop-color: var(--foreground);
    stop-opacity: 0;
  }

  .unlit {
    stop-color: var(--recess);
    stop-opacity: 0;
  }

  .dark {
    stop-color: var(--recess);
    stop-opacity: 0.7;
  }

  .night {
    stop-color: var(--recess);
    stop-opacity: 0.95;
  }

  .highlight-glow {
    stop-color: var(--highlight);
    stop-opacity: 0.5;
  }

  .highlight-none {
    stop-color: var(--highlight);
    stop-opacity: 0;
  }

  .accent-glow {
    stop-color: var(--accent);
    stop-opacity: 0.4;
  }

  .accent-none {
    stop-color: var(--accent);
    stop-opacity: 0;
  }

  .foreground-glow {
    stop-color: var(--foreground);
    stop-opacity: 0.35;
  }

  .foreground-none {
    stop-color: var(--foreground);
    stop-opacity: 0;
  }

  .core {
    stop-color: var(--foreground);
  }

  .highlight-stop {
    stop-color: var(--highlight);
  }

  .accent-stop {
    stop-color: var(--accent);
  }

  .tail-head {
    stop-color: var(--highlight);
    stop-opacity: 0.9;
  }

  .tail-middle {
    stop-color: var(--accent);
    stop-opacity: 0.45;
  }

