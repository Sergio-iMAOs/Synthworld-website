---
/**
 * A field of velvet noise's pulses, as its display draws them (a square up in --foreground, down in --accent, on
 * black), which in space look like stars: one in each cell of a grid, strayed from its place and up or down at random,
 * the same each time. How many of them show is its --density (0 to 1): from a few, crackling, to all of them, a hiss.
 * As it's scrolled through, the page's script gives it how far (--through), and it thickens; without, it's half full.
 * It fills what it's in (which places it), cut to fit, and fades out at its top and bottom.
 */

// Its grid, in its own units (the field is cut to fit, so as wide as a page and as high as a band of one); its pulses
// come on in so many turns, each a set of them at random
const WIDTH = 1600;
const HEIGHT = 900;
const CELL = 38;
const PULSE = 4;
const JITTER = 0.85;
const TURNS = 14;

/** Numbers between 0 and 1 that look random, the same each time (mulberry32) */
const random = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const next = random(0x7e1e7);

const turns = Array.from({ length: TURNS }, () => [] as { x: string; y: string; up: boolean }[]);
for (let y = 0; y < HEIGHT; y += CELL)
  for (let x = 0; x < WIDTH; x += CELL) {
    const [across, down, up, turn] = [next(), next(), next() < 0.5, next()];
    turns[Math.floor(turn * TURNS)].push({
      x: (x + CELL / 2 + (across - 0.5) * JITTER * CELL - PULSE / 2).toFixed(1),
      y: (y + CELL / 2 + (down - 0.5) * JITTER * CELL - PULSE / 2).toFixed(1),
      up,
    });
  }
---

<svg class="velvet-noise" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-seen>
  {
    turns.map((pulses, turn) => (
      <g style={`--from: ${(turn / TURNS).toFixed(3)}`}>
        {pulses.map(({ x, y, up }) => (
          <rect class:list={{ up }} x={x} y={y} width={PULSE} height={PULSE} />
        ))}
      </g>
    ))
  }
</svg>

<style define:vars={{ turns: TURNS }}>
  .velvet-noise {
    --density: clamp(0.05, var(--through, 0.45) * 1.7 - 0.3, 1);
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(transparent, #000 18%, #000 82%, transparent);
    pointer-events: none;
  }

  /* A turn's pulses show once the density is past where it comes on */
  g {
    opacity: clamp(0, (var(--density) - var(--from)) * var(--turns), 1);
  }

  rect {
    fill: var(--accent);
  }

  .up {
    fill: var(--foreground);
  }
</style>
