---
/**
 * A planet, as EARL's Starship skin draws a node of its graph (drawWorld() and drawNodeSymbol() in the framework): its
 * picture (src/space.ts, made at build time), lit from the top left, or uncharted, seen against the light; a ringed
 * one's ring behind it and in front of it: the skin's band of dust, or pulses up and down (EARL's velvet noise). A
 * synth's own is in pieces: its inside (`.core`), and over it its chunks (`.chunk`, each a piece of the picture of
 * them, its middle in its `data-x` and `data-y`), which its parent's CSS can move apart. Round its SVG's centre, its
 * disc's radius ROOM of its units (a ringed one's smaller, its ring within REACH), its atmosphere's glow round it; its
 * CSS gives it its size. With `sight`, the ring of a sight round it, which the skin draws under the mouse: unseen until
 * its parent's CSS shows its `.sight`. Each pulse of a ring of them has a number of its own between 0 and 1 (`--n`, the
 * same each time), for its parent's CSS to tell them apart.
 */
import { chunkLayout, chunksPicture, planetPicture, PULSE_SIDE, PULSES_TO, ringOf, ringPulses, WORLD_DISC, type World } from '@/space';

interface Props {
  world: World;
  uncharted?: boolean;
  sight?: boolean;
  class?: string;
}

const { world, uncharted = false, sight = false, class: className } = Astro.props;

// Its picture's side (its disc and its glow round it), the SVG's: a planet's disc's radius is ROOM, but a ringed
// one's is smaller, so that its ring stays within REACH of its centre (in its node's box)
const ROOM = 75;
const REACH = 114;
const SIDE = ROOM / WORLD_DISC;
const ring = ringOf(world);
/** How far out its ring goes, of its disc's radius */
const ringReach = ring === 'dust' ? 1.85 * 1.09 + 0.05 : ring === 'pulses' ? PULSES_TO + PULSE_SIDE : 1;
const RADIUS = Math.min(ROOM, REACH / ringReach);
const picture = RADIUS / WORLD_DISC;

// A synth's chunks, each where its piece of the planet's picture is, cut from the picture of them
const layout = chunkLayout(world);
const units = layout ? picture / layout.side : 1;

// A ring of dust, seen tilted: its band and the bright line round it, each half an ellipse behind the planet and half
// in front (the skin's drawRing(), its sizes of the planet's radius)
const RING_TILT = (-0.3 * 180) / Math.PI;
const half = (radius: number, far: boolean) => {
  const [rx, ry] = [radius, radius * 0.26];
  return far ? `M${-rx} 0A${rx} ${ry} 0 0 1 ${rx} 0` : `M${rx} 0A${rx} ${ry} 0 0 1 ${-rx} 0`;
};
const dust = (far: boolean) => [
  { class: 'band', d: half(RADIUS * 1.85, far), width: RADIUS * 0.17 },
  { class: 'line', d: half(RADIUS * 1.85 * 1.09, far), width: Math.max(0.75, RADIUS * 0.045) },
];

// A ring of pulses: the squares on its far half, behind the planet, and on its near half, in front
const pulses = ring === 'pulses' ? ringPulses(world) : [];
const PULSE = PULSE_SIDE * RADIUS;
const numberOf = (index: number) => {
  const wave = Math.sin(index * 12.9898 + 78.233) * 43758.5453;
  return (wave - Math.floor(wave)).toFixed(3);
};
const pulsesOn = (near: boolean) =>
  pulses
    .map((pulse, index) => ({ ...pulse, n: numberOf(index) }))
    .filter((pulse) => pulse.near === near)
    .map(({ x, y, up, n }) => ({ up, n, x: (x * RADIUS - PULSE / 2).toFixed(1), y: (y * RADIUS - PULSE / 2).toFixed(1) }));

// The sight's ring: a gap from the disc, and a tick out of it at each quarter
const SIGHT = RADIUS + 6;
const TICK = `M${SIGHT} 0h9`;
const quarters = [0, 90, 180, 270];
---

<svg class:list={['planet', className]} viewBox={`${-SIDE / 2} ${-SIDE / 2} ${SIDE} ${SIDE}`} aria-hidden="true">
  {
    [true, false].map((far) => (
      <>
        {!far &&
          (layout ? (
            <>
              <image class="core" href={planetPicture(world)} x={-picture / 2} y={-picture / 2} width={picture} height={picture} />
              {layout.chunks.map(({ x, y, width, height, atlasX, atlasY, middle }) => (
                <g class="chunk" data-chunk data-x={(middle[0] * RADIUS).toFixed(1)} data-y={(middle[1] * RADIUS).toFixed(1)}>
                  <g class="drift">
                    <svg
                      x={(-picture / 2 + x * units).toFixed(2)}
                      y={(-picture / 2 + y * units).toFixed(2)}
                      width={(width * units).toFixed(2)}
                      height={(height * units).toFixed(2)}
                      viewBox={`${atlasX} ${atlasY} ${width} ${height}`}
                      preserveAspectRatio="none"
                    >
                      <image href={chunksPicture(world)} width={layout.width} height={layout.height} />
                    </svg>
                  </g>
                </g>
              ))}
            </>
          ) : (
            <image class="whole" href={planetPicture(world, uncharted)} x={-picture / 2} y={-picture / 2} width={picture} height={picture} />
          ))}
        {ring && (
          <g class="ring">
            {ring === 'dust' && dust(far).map(({ class: kind, d, width }) => <path class={kind} d={d} stroke-width={width} transform={`rotate(${RING_TILT})`} />)}
            {pulsesOn(!far).map(({ up, n, x, y }) => (
              <rect class:list={['pulse', { far, up }]} x={x} y={y} width={PULSE} height={PULSE} style={`--n: ${n}`} />
            ))}
          </g>
        )}
      </>
    ))
  }
  {
    sight && (
      <g class="sight">
        <circle class="glow" r={SIGHT} />
        <circle r={SIGHT} />
        {quarters.map((angle) => (
          <>
            <path class="glow" d={TICK} transform={`rotate(${angle})`} />
            <path d={TICK} transform={`rotate(${angle})`} />
          </>
        ))}
      </g>
    )
  }
</svg>

<style>
  .planet {
    display: block;
    overflow: visible;
  }

  /* What moves when a synth's planet opens (SynthGraph): each round its own middle */
  .core,
  .chunk,
  .drift {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* The skin's ring's colours: part of the planet, as its picture's are */
  .band,
  .line {
    fill: none;
  }

  .band {
    stroke: #e7a6ff;
    stroke-opacity: 0.5;
  }

  .line {
    stroke: #ffe0f8;
    stroke-opacity: 0.7;
  }

  /* A velvet noise's pulses, in its display's two colours: up, and down; dimmer on the ring's far half */
  .pulse {
    fill: var(--accent);
  }

  .pulse.up {
    fill: var(--foreground);
  }

  .pulse.far {
    opacity: 0.7;
  }

  /* The sight: in the colour of what's under the mouse, glowing */
  .sight {
    fill: none;
    stroke: var(--highlight);
    stroke-width: 1.5;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .sight .glow {
    stroke-width: 4.5;
    stroke-opacity: 0.22;
  }
</style>
