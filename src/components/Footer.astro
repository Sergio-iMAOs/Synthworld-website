---
import { langOf, textsOf } from '@/i18n';

const t = textsOf(langOf(Astro.url));
---

<footer>
  <div class="wrap">
    <p class="muted">{t.footer}</p>
  </div>
</footer>

<style>
  footer {
    padding-block: 1.5rem;
    background: var(--recess);
    font-size: 0.9rem;
  }

  p {
    margin: 0;
  }
</style>
