---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SynthGet from '@/components/SynthGet.astro';

export async function getStaticPaths() {
  const synths = await getCollection('synths');
  return synths.map((synth) => ({ params: { id: synth.id }, props: { synth } }));
}

const { synth } = Astro.props;
const { data } = synth;
const { Content } = await render(synth);
---

<Base title={data.name} description={data.summary}>
  <section class="section">
    <div class="wrap">
      <h1>{data.name}</h1>
      <p class="lead">{data.summary}</p>
      <ul class="tags">
        <li>v{data.version}</li>
        <li>{data.paid ? data.paid.price : 'Free'}</li>
        {data.formats.map((format) => <li>{format}</li>)}
        {data.platforms.map((platform) => <li>{platform}</li>)}
      </ul>
      <Content />
      <SynthGet synth={synth} />
    </div>
  </section>
</Base>
