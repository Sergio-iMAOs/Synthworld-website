---
import Base from '@/layouts/Base.astro';
import SynthGet from '@/components/SynthGet.astro';
import { langOf, langPaths, pathIn, textsOf } from '@/i18n';
import { getSynths } from '@/synths';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url);
const t = textsOf(lang).download;
const released = (await getSynths(lang)).filter(({ data }) => data.downloads.some(({ url }) => url) || data.paid?.buyUrl);
---

<Base title={t.title} description={t.description}>
  <section class="section">
    <div class="wrap">
      <h1>{t.title}</h1>
      {
        released.length === 0 ? (
          <p class="lead">{t.nothing}</p>
        ) : (
          <ul class="grid">
            {released.map((synth) => (
              <li class="card">
                <h2>
                  <a href={pathIn(lang, `/synths/${synth.id}/`)}>{synth.data.name}</a>{' '}
                  <span class="muted">v{synth.data.version}</span>
                </h2>
                <SynthGet synth={synth} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
