---
import Base from '@/layouts/Base.astro';
import Space from '@/components/Space.astro';
import SynthGraph from '@/components/SynthGraph.astro';
import { langOf, langPaths, textsOf } from '@/i18n';
import { getSynths } from '@/synths';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url);
const t = textsOf(lang).synths;
const synths = await getSynths(lang);
---

<Base title={t.title} description={t.lead}>
  <Space pannedBy="graph" />
  <SynthGraph synths={synths} />
</Base>
