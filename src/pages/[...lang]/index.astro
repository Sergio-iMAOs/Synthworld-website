---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SineTrail from '@/components/SineTrail.astro';
import Space from '@/components/Space.astro';
import SpaceObject, { type SpaceObjectKind } from '@/components/SpaceObject.astro';
import { langOf, langPaths, pathIn, textsOf } from '@/i18n';
import { site } from '@/site';
import { getSynths } from '@/synths';
import logo from '@/assets/synthworld/logo.png';
import name from '@/assets/synthworld/name.png';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url);
const t = textsOf(lang);
const synths = await getSynths(lang);

// The engine's features, in their order (ui.ts), each as a thing in space
const objects: SpaceObjectKind[] = ['binary', 'constellation', 'comet', 'rings', 'satellite'];
if (t.home.features.length !== objects.length) throw new Error(`The home page has ${objects.length} things in space for ${t.home.features.length} features`);
---

<Base>
  <Space />
  <SineTrail />

  <section class="hero">
    <p class="construction" role="status">{t.home.construction}</p>
    <div class="wrap scene">
      <div class="planet">
        <Image src={logo} alt="" widths={[400, 800, 1356]} sizes="(min-width: 68rem) 19rem, 13rem" loading="eager" />
      </div>
      <h1>
        <Image class="name" src={name} alt={site.name} widths={[600, 1200, 2400]} sizes="(min-width: 36rem) 30rem, 85vw" loading="eager" />
        <span class="tagline">{t.tagline}</span>
      </h1>
      <p class="lead">{t.home.lead}</p>
      <a class="button" href={pathIn(lang, '/synths/')}>{t.home.cta}</a>
    </div>
  </section>

  {
    synths.map((synth, index) => {
      const { id, data, text } = synth;
      const href = pathIn(lang, `/synths/${id}/`);
      // Its window in SynthWorld's light skin, which every synth has: its own for this page, or its skin's; without
      // either, its cover
      const picture = data.home?.day ?? data.skins.find(({ name }) => name === 'SW Light') ?? data.cover;
      return (
        <article class="synth">
          <header class={data.logo ? 'rise sunrise' : 'rise'}>
            <div class="wrap">
              {index === 0 && <p class="kicker">{t.home.first}</p>}
              <h2 class="sun">
                <a href={href}>
                  {data.logo ? (
                    <Image class="logo" src={data.logo} alt={data.name} widths={[300, 600, 1200]} sizes="36rem" loading={index === 0 ? 'eager' : 'lazy'} />
                  ) : (
                    data.name
                  )}
                </a>
              </h2>
            </div>
            {data.logo && <div class="horizon" />}
          </header>

          <div class="wrap ground">
            {picture && (
              <a class="orbit" href={href}>
                <span class="ring back" aria-hidden="true" />
                <span class="sight">
                  <Image class="window" src={picture.image} alt={picture.alt[lang]} widths={[800, 1200, 1600, 2400]} sizes="(min-width: 68rem) 56rem, 100vw" />
                </span>
                <span class="ring front" aria-hidden="true">
                  <span class="moon" />
                </span>
              </a>
            )}
            <div class="about">
              <p class="lead">{text.data.summary}</p>
              <ul class="tags">
                <li>{data.paid ? data.paid.price : t.synths.free}</li>
                {data.formats.map((format) => (
                  <li>{format}</li>
                ))}
                {data.platforms.map((platform) => (
                  <li>{platform}</li>
                ))}
              </ul>
              <a class="button" href={href}>
                {t.home.discover(data.name)}
              </a>
            </div>
          </div>
        </article>
      );
    })
  }

  <section class="section">
    <div class="wrap">
      <h2 class="engine">{t.home.engine}</h2>
      <ul class="features">
        {
          t.home.features.map(({ title, text }, index) => (
            <li>
              <SpaceObject kind={objects[index]} />
              <h3>{title}</h3>
              <p class="muted">{text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /*
   * The page is in space (Space): first SynthWorld, its planet (its logo, shaded) over its name, as tall as most of
   * the window, so that the first synth's horizon shows under it. A sine wave follows the mouse over the whole page
   * (SineTrail).
   */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: calc(100svh - 16rem);
    padding-block: 1.5rem clamp(2rem, 5vw, 3rem);
    text-align: center;
  }

  /* A beacon: the site isn't finished */
  .construction {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    max-width: calc(100% - 2 * var(--gutter));
    margin: 0 0 clamp(1.5rem, 4vw, 2.25rem);
    padding: 0.35rem 1rem;
    border: 1px solid color-mix(in srgb, var(--warning) 55%, transparent);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--recess) 75%, transparent);
    font-size: 0.85rem;
    text-align: left;
  }

  .construction::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--warning);
    box-shadow: 0 0 0.5rem var(--warning);
  }

  .scene {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-block: auto;
  }

  /* The planet, lit by a halo of its own colour */
  .planet {
    position: relative;
    width: clamp(13rem, 28vw, 19rem);
    margin-bottom: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .planet::before {
    content: '';
    position: absolute;
    inset: -35% -25%;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 32%, transparent), transparent);
  }

  .planet img {
    display: block;
    width: 100%;
    height: auto;
  }

  h1 {
    margin-bottom: 1rem;
  }

  .name {
    display: block;
    width: min(30rem, 85vw);
    height: auto;
    margin: 0 auto 1rem;
  }

  .tagline {
    display: block;
    font-size: clamp(1.35rem, 3.2vw, 2rem);
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .lead {
    margin-inline: auto;
  }

  .hero .lead {
    max-width: 36rem;
    margin-bottom: 1.75rem;
  }

  /*
   * Each synth: its logo rising over a horizon that crosses the page, as on its page (the sun and the name, the sun's
   * radius high, standing a tenth of the radius over the horizon, a tenth thick); the sky lit behind the sun. The sun's
   * radius: as big as fits, the logo being 6.04 radii wide, the sun's centre one radius from its left.
   */
  .synth {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
  }

  .synth + .synth {
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .rise {
    --sun: min(6rem, (100vw - 2 * var(--gutter)) / 6.04);
    position: relative;
    text-align: center;
  }

  .sunrise::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: calc(50% - var(--sun) * 5.52);
    bottom: calc(var(--sun) * 0.1);
    width: calc(var(--sun) * 7);
    height: calc(var(--sun) * 2.8);
    background: radial-gradient(50% 100% at 50% 100%, color-mix(in srgb, var(--accent) 40%, transparent), transparent);
    pointer-events: none;
  }

  .kicker {
    margin-bottom: 1.25rem;
    color: var(--surface);
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Its bottom is the horizon's: what of the sun is under it isn't seen */
  .sun {
    display: flex;
    justify-content: center;
    margin: 0;
    clip-path: inset(-100vmax -100vmax 0 -100vmax);
  }

  .sun a {
    color: var(--foreground);
    text-decoration: none;
  }

  .logo {
    display: block;
    width: auto;
    height: var(--sun);
  }

  .horizon {
    height: calc(var(--sun) * 0.1);
    margin-top: calc(var(--sun) * 0.1);
    background: var(--foreground);
    box-shadow: 0 0 calc(var(--sun) * 0.3) color-mix(in srgb, var(--accent) 60%, transparent);
  }

  /* The night under the horizon, darker than space, fading into it */
  .sunrise::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 100%;
    left: 0;
    right: 0;
    height: 28rem;
    background: linear-gradient(rgb(0 0 0 / 0.8), transparent);
    pointer-events: none;
  }

  /* As the page scrolls, the sun rises, and the sky lights up behind it */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .sunrise {
        view-timeline: --rise;
      }

      /* In longhands: a minifier would put the timeline in the shorthand, where browsers don't take it */
      .logo,
      .sunrise::before {
        animation-name: rise;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --rise;
        animation-range: cover 0% cover 45%;
      }

      .sunrise::before {
        animation-name: dawn;
      }
    }
  }

  @keyframes rise {
    from {
      translate: 0 90%;
    }
  }

  @keyframes dawn {
    from {
      opacity: 0.1;
    }
  }

  /* Its window, and what it is */
  .ground {
    padding-block: clamp(2rem, 5vw, 3rem) 0;
  }

  .about {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }

  .about .lead,
  .about .tags {
    margin: 0;
  }

  .tags {
    justify-content: center;
  }

  /*
   * Its window, a link to its page, in orbit: in the corners of a sight (as the synths' page's nodes are), shining in
   * space, lit from the top left, a ring round it with a moon on it, its back half behind the window and its front half
   * over it. As it comes into view, it turns to face the visitor; under the mouse, it rises, and its sight lights up.
   */
  .orbit {
    --sight: color-mix(in srgb, var(--accent) 50%, transparent);
    --arm: 1.5rem;
    --line: 1.5px;
    position: relative;
    isolation: isolate;
    display: block;
    max-width: 56rem;
    margin-inline: auto;
    padding: clamp(0.5rem, 1.5vw, 0.9rem);
    transition: translate 0.4s ease-out;
  }

  /* Its glow: violet light round it, yellow where the light falls from */
  .orbit::before {
    content: '';
    position: absolute;
    inset: -18% -12%;
    z-index: -2;
    background:
      radial-gradient(30% 34% at 30% 26%, color-mix(in srgb, var(--highlight) 14%, transparent), transparent),
      radial-gradient(closest-side, color-mix(in srgb, var(--accent) 34%, transparent), transparent);
    transition: opacity 0.4s;
    opacity: 0.75;
    pointer-events: none;
  }

  .orbit:is(:hover, :focus-visible) {
    --sight: color-mix(in srgb, var(--highlight) 90%, transparent);
    translate: 0 -0.5rem;
  }

  .orbit:is(:hover, :focus-visible)::before {
    opacity: 1;
  }

  .orbit:focus-visible {
    outline: none;
  }

  .sight {
    position: relative;
    z-index: 0;
    display: block;
  }

  .sight::before {
    content: '';
    position: absolute;
    inset: calc(-1 * clamp(0.5rem, 1.5vw, 0.9rem));
    background:
      linear-gradient(var(--sight) 0 0) top left / var(--arm) var(--line),
      linear-gradient(var(--sight) 0 0) top left / var(--line) var(--arm),
      linear-gradient(var(--sight) 0 0) top right / var(--arm) var(--line),
      linear-gradient(var(--sight) 0 0) top right / var(--line) var(--arm),
      linear-gradient(var(--sight) 0 0) bottom left / var(--arm) var(--line),
      linear-gradient(var(--sight) 0 0) bottom left / var(--line) var(--arm),
      linear-gradient(var(--sight) 0 0) bottom right / var(--arm) var(--line),
      linear-gradient(var(--sight) 0 0) bottom right / var(--line) var(--arm);
    background-repeat: no-repeat;
    transition: filter 0.4s;
    pointer-events: none;
  }

  .orbit:is(:hover, :focus-visible) .sight::before {
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--highlight) 50%, transparent));
  }

  /* The light falling on its glass from the top left */
  .sight::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    background: linear-gradient(135deg, color-mix(in srgb, var(--foreground) 16%, transparent), transparent 35%);
    pointer-events: none;
  }

  .window {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--surface) 25%, transparent);
    border-radius: var(--radius);
    box-shadow:
      0 2rem 4rem -2rem rgb(0 0 0 / 0.8),
      0 0 5rem -1rem color-mix(in srgb, var(--accent) 35%, transparent);
  }

  /* The ring, wider than the window and tilted: an ellipse, cut in its back half and its front half */
  .ring {
    position: absolute;
    inset: 24% -7% 12%;
    border: 1.5px solid color-mix(in srgb, var(--surface) 45%, transparent);
    border-radius: 50%;
    rotate: -6deg;
    transition: border-color 0.4s;
    pointer-events: none;
  }

  .back {
    z-index: -1;
    border-color: color-mix(in srgb, var(--surface) 25%, transparent);
    clip-path: inset(-2rem -2rem 50% -2rem);
  }

  .front {
    z-index: 1;
    clip-path: inset(50% -2rem -2rem -2rem);
  }

  .orbit:is(:hover, :focus-visible) .ring {
    border-color: color-mix(in srgb, var(--highlight) 55%, transparent);
  }

  /* The moon, on the ring's front, just out of the window on its left: lit, then shaded, from the top left */
  .moon {
    position: absolute;
    left: 3%;
    top: 67%;
    width: clamp(0.7rem, 1.6vw, 1.1rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 30%, color-mix(in srgb, var(--foreground) 85%, transparent), transparent 55%),
      radial-gradient(circle at 32% 30%, transparent 35%, color-mix(in srgb, var(--recess) 85%, transparent)),
      var(--highlight);
    box-shadow: 0 0 0.9rem color-mix(in srgb, var(--highlight) 45%, transparent);
  }

  /* As it comes into view, it turns from lying back in space to facing the visitor */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .orbit {
        animation-name: face;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }

  @keyframes face {
    from {
      transform: perspective(70rem) rotateX(24deg) scale(0.92);
      opacity: 0.4;
    }
    to {
      transform: perspective(70rem) rotateX(0deg) scale(1);
      opacity: 1;
    }
  }

  /*
   * What every synth has: each a thing in space over its text; three in a row, the middle one lower, a wave, and a
   * last row that isn't full in the middle
   */
  .engine {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 3rem 2rem;
    padding: 0;
    margin: 0;
    list-style: none;
    text-align: center;
  }

  .features li {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .features h3 {
    margin-top: 1.25rem;
  }

  .features p {
    max-width: 20rem;
    margin: 0;
  }

  @media (min-width: 56rem) {
    .features {
      grid-template-columns: repeat(6, 1fr);
    }

    .features li {
      grid-column: span 2;
    }

    .features li:nth-child(3n + 1):nth-last-child(2) {
      grid-column: 2 / span 2;
    }

    .features li:nth-child(3n + 1):last-child {
      grid-column: 3 / span 2;
    }

    .features li:nth-child(3n + 2) {
      padding-top: 4rem;
    }
  }

  /* The planet floats, and the beacon blinks, unless the visitor asked for less motion */
  @media (prefers-reduced-motion: no-preference) {
    .planet img {
      animation: float 7s ease-in-out infinite alternate;
    }

    .construction::before {
      animation: blink 1.8s ease-in-out infinite alternate;
    }
  }

  @keyframes float {
    from {
      transform: translateY(-0.6rem) rotate(-2deg);
    }
    to {
      transform: translateY(0.6rem) rotate(2deg);
    }
  }

  @keyframes blink {
    to {
      opacity: 0.3;
    }
  }
</style>
