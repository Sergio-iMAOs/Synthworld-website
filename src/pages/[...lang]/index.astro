---
import Base from '@/layouts/Base.astro';
import SynthCard from '@/components/SynthCard.astro';
import { langOf, langPaths, pathIn, textsOf } from '@/i18n';
import { getSynths } from '@/synths';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url);
const t = textsOf(lang);
const synths = await getSynths(lang);
---

<Base>
  <section class="section">
    <div class="wrap">
      <p class="construction" role="status">{t.home.construction}</p>
      <h1>{t.tagline}</h1>
      <p class="lead">{t.home.lead}</p>
      <a class="button" href={pathIn(lang, '/synths/')}>{t.home.cta}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{t.home.synths}</h2>
      <ul class="grid">
        {synths.map((synth) => <SynthCard synth={synth} />)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{t.home.engine}</h2>
      <ul class="grid">
        {
          t.home.features.map(({ title, text }) => (
            <li class="card">
              <h3>{title}</h3>
              <p class="muted">{text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .construction {
    display: inline-block;
    margin-bottom: 2rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--warning);
    border-radius: var(--radius);
    color: var(--warning);
    font-family: var(--font-display);
  }
</style>
