---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { defaultLang, langOf, languages, pathIn, pathWithoutLang, textsOf, type Lang } from '@/i18n';
import { site } from '@/site';

interface Props {
  /** The page's own title; the site's name is added to it. Without one, the title is the site's. */
  title?: string;
  description?: string;
}

const lang = langOf(Astro.url);
const t = textsOf(lang);
const { title, description = t.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${t.tagline}`;

// The same page in every language, for search engines (absolute once `site` is set in astro.config.mjs)
const path = pathWithoutLang(Astro.url);
const address = (code: Lang) => (Astro.site ? new URL(pathIn(code, path), Astro.site).href : pathIn(code, path));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={address(lang)} />
    {(Object.keys(languages) as Lang[]).map((code) => <link rel="alternate" hreflang={code} href={address(code)} />)}
    <link rel="alternate" hreflang="x-default" href={address(defaultLang)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#232125" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
